# Flask environment variables
SECRET_KEY="Your secret key"
DEBUG="False"
TESTING="False"
FLASK_LOG_FILE="logs/beamtime_app.log"

# Database configuration environment variables
DATABASE_URI="postgresql+psycopg2://<db_user>:<password>@<host>:<port>/<db_name>"

# LDAP Server Configuration
LDAP_HOST="ldap://your-domain-controller.company.com"   # LDAP server
LDAP_PORT="389"                                         # Port (389 for LDAP, 636 for LDAPS)
LDAP_USE_SSL="False"                                    # Set to True for LDAPS
LDAP_USE_TLS="True"                                     # Set to True to use STARTTLS
LDAP_BIND_DN="CN=BeamtimeApp Service,OU=Service Accounts,DC=company,DC=com"
LDAP_BIND_PASSWORD="service_account_password"
LDAP_USER_DN="OU=Users,DC=company,DC=com"
LDAP_USER_LOGIN_ATTR="sAMAccountName"
LDAP_USER_FIRST_NAME_ATTR="givenName"
LDAP_USER_LAST_NAME_ATTR="sn"
LDAP_REQUIRE_GROUP="True"
LDAP_AUTHORIZED_GROUPS="CN=BeamtimeApp Users,OU=Groups,DC=company,DC=com;CN=Scientists,OU=Groups,DC=company,DC=com"

# Session Settings
SESSION_PERMANENT="True"
PERMANENT_SESSION_LIFETIME="8"

# Gunicorn Configuration
GUNICORN_BIND="0.0.0.0:5000"                            # Bind address and port
GUNICORN_WORKERS="4"                                    # Number of worker processes
GUNICORN_TIMEOUT="60"                                   # Worker timeout in seconds
GUNICORN_GRACEFUL_TIMEOUT="30"                          # Graceful shutdown timeout
GUNICORN_ACCESS_LOG="logs/server_access.log"            # Access log file
GUNICORN_ERROR_LOG="logs/server_error.log"              # Error log file
