# ----------------------------------------------------------------------------------
# Project: BeamtimeApp
# File: .gitignore
# ----------------------------------------------------------------------------------
# Purpose: 
# This file is used by Git to determine which files and directories to ignore 
# when committing changes.
# ----------------------------------------------------------------------------------
# Author: Christofanis Skordas
#
# Copyright (C) 2025-2026 GSECARS, The University of Chicago, USA
# Copyright (C) 2025-2026 NSF SEES, USA
# ----------------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
*.egg-info/
dist/
build/
wheels/

# Python virtual environments
venv/
.venv/
ENV/
env/

# OS generated files
.DS_Store
._*
Thumbs.db
Desktop.ini
*~

# Editors
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# Tools
*.mypy_cache/

# Logs
logs/
*.log

# TypeScript / Node.js
node_modules/
*.js.map
*.d.ts
!beamtime_app/static/js/**/*.js
beamtime_app/static/js/**/*.js.map
beamtime_app/static/js/**/*.d.ts

# Sensitive data
.env